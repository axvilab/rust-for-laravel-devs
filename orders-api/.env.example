# cp .env.example .env   — read by dotenvy in dev and by `#[sqlx::test]`.
# In production there is no .env: pass real environment variables.

# Postgres from `docker compose up -d db`
DATABASE_URL=postgres://postgres:pg@localhost:5432/orders
# Required. The app refuses to start without it.
JWT_SECRET=change-me
# Optional (defaults shown)
# HOST=0.0.0.0
# PORT=3000
# LOG_JSON=false
# DB_MAX_CONNECTIONS=20
# REQUEST_TIMEOUT_SECS=10
# JWT_TTL_HOURS=12
# Comma-separated; empty = permissive CORS (dev only)
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
RUST_LOG=info,sqlx=warn
